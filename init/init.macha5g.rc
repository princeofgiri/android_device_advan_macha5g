# Device-specific init for Advan Macha 5G (mt6855)

on early-init
    write /dev/kmsg "=== INIT_STAGE: early-init ==="
    write /sys/module/musb_hdrc/parameters/kernel_init_done 1
    setprop keystore.module_hash.sent true
    setprop odsign.key.done 1
    setprop odsign.verification.done 1
    setprop ro.vendor.soc.manufacturer "Mediatek"
    setprop ro.vendor.soc.model "MT6855"
    setprop ro.vendor.soc.model.external_name "MT6855"
    setprop ro.vendor.soc.model.part_name "MT6855"
    setprop ro.vendor.soc.model_ready 1
    setprop ro.soc.manufacturer "Mediatek"
    setprop ro.soc.model "MT6855"

on init
    write /dev/kmsg "=== INIT_STAGE: init ==="
    write /sys/module/musb_hdrc/parameters/kernel_init_done 1
    write /sys/class/udc/musb-hdrc/device/cmode 3
    write /sys/class/usb_role/mt_usb-role-switch/role device
    write /sys/devices/platform/soc/mt_usb/portmode 0
    setprop sys.usb.configfs 1
    setprop sys.usb.controller "musb-hdrc"
    setprop vendor.usb.controller "musb-hdrc"
    setprop persist.sys.usb.config adb

on early-fs
    write /dev/kmsg "=== INIT_STAGE: early-fs ==="

on fs
    write /dev/kmsg "=== INIT_STAGE: fs ==="

on post-fs
    write /dev/kmsg "=== INIT_STAGE: post-fs ==="
    mount configfs none /config
    mkdir /config/usb_gadget/g1 0770 shell shell
    write /config/usb_gadget/g1/idVendor 0x18d1
    mkdir /config/usb_gadget/g1/strings/0x409 0770
    write /config/usb_gadget/g1/strings/0x409/serialnumber ${ro.serialno}
    write /config/usb_gadget/g1/strings/0x409/manufacturer ${ro.product.manufacturer}
    write /config/usb_gadget/g1/strings/0x409/product ${ro.product.model}
    mkdir /config/usb_gadget/g1/functions/ffs.adb
    mkdir /config/usb_gadget/g1/configs/b.1 0777 shell shell
    write /config/usb_gadget/g1/configs/b.1/MaxPower 500
    mkdir /config/usb_gadget/g1/configs/b.1/strings/0x409 0770 shell shell
    mkdir /dev/usb-ffs 0775 shell shell
    mkdir /dev/usb-ffs/adb 0770 shell shell
    mount functionfs adb /dev/usb-ffs/adb uid=2000,gid=2000

on late-fs
    write /dev/kmsg "=== INIT_STAGE: late-fs ==="

on post-fs-data
    write /dev/kmsg "=== INIT_STAGE: post-fs-data ==="

    # Awinic audio effect 64-bit symlink for hardcoded path in audio HAL
    mkdir /vendor/lib/hw 0755 root root
    symlink /vendor/lib64/hw/awinic.audio.effect.so /vendor/lib/hw/awinic.audio.effect.so

    # MTK MDP permissions
    chmod 0666 /dev/mtk_mdp
    chmod 0666 /dev/mdp_sync
    chown system system /dev/mtk_mdp
    chown system system /dev/mdp_sync

    # Fingerprint data directory for Goodix
    mkdir /data/gf_data 0770 system system
    restorecon /data/gf_data

    # FOD touchscreen and display nodes
    chown system system /sys/devices/platform/soc/11013000.spi3/spi_master/spi3/spi3.0/fts_fod_mode
    chmod 0666 /sys/devices/platform/soc/11013000.spi3/spi_master/spi3/spi3.0/fts_fod_mode
    chown system system /sys/devices/platform/common_node/finger
    chmod 0666 /sys/devices/platform/common_node/finger
    chown system system /sys/devices/platform/common_node/gesture
    chmod 0666 /sys/devices/platform/common_node/gesture
    chown system system /sys/devices/platform/common_node/hbmstate
    chmod 0666 /sys/devices/platform/common_node/hbmstate

    setprop keystore.module_hash.sent true
    setprop odsign.key.done 1
    setprop odsign.verification.done 1
    setprop ro.vendor.soc.model_ready 1
    setprop ro.soc.manufacturer "Mediatek"
    setprop ro.soc.model "MT6855"
    setprop persist.sys.usb.config adb
    setprop sys.usb.config none
    setprop sys.usb.config adb

on zygote-start
    write /dev/kmsg "=== INIT_STAGE: zygote-start ==="

on early-boot
    write /dev/kmsg "=== INIT_STAGE: early-boot ==="

on boot
    write /dev/kmsg "=== INIT_STAGE: boot ==="
    # MediaTek camera ISP & DIP SMI power domain keep alive
    write /sys/devices/platform/soc/soc:smi_pd_dip1/power/control on
    write /sys/devices/platform/soc/soc:smi_pd_isp_main/power/control on
    write /sys/module/musb_hdrc/parameters/kernel_init_done 1
    write /sys/class/udc/musb-hdrc/device/cmode 3
    write /sys/class/usb_role/mt_usb-role-switch/role device
    write /sys/devices/platform/soc/mt_usb/portmode 0
    setprop sys.usb.config adb
    start adbd

    # Start MediaTek RIL daemon
    setprop vendor.ril.mtk 1
    start vendor.ril-daemon-mtk

on property:sys.usb.config=adb
    write /sys/module/musb_hdrc/parameters/kernel_init_done 1
    write /sys/class/udc/musb-hdrc/device/cmode 3
    write /sys/class/usb_role/mt_usb-role-switch/role device
    write /sys/devices/platform/soc/mt_usb/portmode 0
    start adbd

on property:sys.usb.ffs.ready=1 && property:sys.usb.config=adb
    write /config/usb_gadget/g1/configs/b.1/strings/0x409/configuration "adb"
    write /config/usb_gadget/g1/idVendor 0x18d1
    write /config/usb_gadget/g1/idProduct 0xd001
    symlink /config/usb_gadget/g1/functions/ffs.adb /config/usb_gadget/g1/configs/b.1/f1
    write /config/usb_gadget/g1/UDC "musb-hdrc"
    setprop sys.usb.state adb
    write /dev/kmsg "=== USB_ADB: Gadget bound to musb-hdrc (18d1:d001) ==="
